<?xml version="1.0" encoding="UTF-8"?>
<windows>

  <!-- Player Inventory -->
  <setattribute xpath="/windows/window[@name='windowBackpack']/rect[@name='header']/rect[@controller='ContainerStandardControls']" name="pos">175, 0</setattribute>

  <setattribute xpath="/windows/window[@name='windowBackpack']/rect[@name='header']/rect[@controller='ContainerStandardControls']/button[@name='btnClearInventory']" name="pos">160, -22</setattribute>

  <append xpath="/windows/window[@name='windowBackpack']/rect[@name='header']/rect[@controller='ContainerStandardControls']">

    <rect name="beyondsmart_bp_player_backpack" visible="{bs_is_player_storage_only}">
      <button depth="3" name="btnBeyondSmartPlayerInventoryPullLoadout" sprite="ui_symbol_beyond_smart_loot_pull_loadout" tooltip_key="btnBeyondSmartPlayerInventoryPullLoadout_ToolTip" pos="200, -22" style="icon32px, press, hover" pivot="center" sound="[paging_click]" />
      <button depth="3" name="btnBeyondSmartPlayerInventoryPush" sprite="ui_symbol_beyond_smart_loot_push" tooltip_key="btnBeyondSmartPlayerInventoryPush_ToolTip" pos="240, -22" style="icon32px, press, hover" pivot="center" sound="[paging_click]" />
    </rect>

    <rect name="beyondsmart_bp_player_looting" visible="{lootingorvehiclestorage}">
      <button depth="3" name="btnBeyondSmartPlayerLootingPullLoadout" sprite="ui_symbol_beyond_smart_loot_pull_loadout" tooltip_key="btnBeyondSmartPlayerInventoryPullLoadout_ToolTip" pos="200, -22" style="icon32px, press, hover" pivot="center" sound="[paging_click]" />
      <button depth="3" name="btnBeyondSmartPlayerLootingPush" sprite="ui_symbol_beyond_smart_loot_push" tooltip_key="btnBeyondSmartPlayerInventoryPush_ToolTip" pos="240, -22" style="icon32px, press, hover" pivot="center" sound="[paging_click]" />
    </rect>

  </append>

  <!-- Player Inventory for AGF V3 Larger Backpacks 60-72-84-119 -->
  <conditional>
    <if cond="mod_loaded('AGF-BackpackPlus-060Slots') or mod_loaded('AGF-BackpackPlus-072Slots') or mod_loaded('AGF-BackpackPlus-084Slots') or mod_loaded('AGF-BackpackPlus-119Slots')">
      <setattribute xpath="/windows/window[@name='windowBackpackAGF']/rect[@name='header']/rect[@controller='ContainerStandardControls']" name="pos">175, 0</setattribute>

      <setattribute xpath="/windows/window[@name='windowBackpackAGF']/rect[@name='header']/rect[@controller='ContainerStandardControls']/button[@name='btnClearInventory']" name="pos">160, -22</setattribute>

      <append xpath="/windows/window[@name='windowBackpackAGF']/rect[@name='header']/rect[@controller='ContainerStandardControls']">

        <rect name="beyondsmart_bp_player_backpack" visible="{bs_is_player_storage_only}">
          <button depth="3" name="btnBeyondSmartPlayerInventoryPullLoadout" sprite="ui_symbol_beyond_smart_loot_pull_loadout" tooltip_key="btnBeyondSmartPlayerInventoryPullLoadout_ToolTip" pos="200, -22" style="icon32px, press, hover" pivot="center" sound="[paging_click]" />
          <button depth="3" name="btnBeyondSmartPlayerInventoryPush" sprite="ui_symbol_beyond_smart_loot_push" tooltip_key="btnBeyondSmartPlayerInventoryPush_ToolTip" pos="240, -22" style="icon32px, press, hover" pivot="center" sound="[paging_click]" />
        </rect>

        <rect name="beyondsmart_bp_player_looting" visible="{lootingorvehiclestorage}">
          <button depth="3" name="btnBeyondSmartPlayerLootingPullLoadout" sprite="ui_symbol_beyond_smart_loot_pull_loadout" tooltip_key="btnBeyondSmartPlayerInventoryPullLoadout_ToolTip" pos="200, -22" style="icon32px, press, hover" pivot="center" sound="[paging_click]" />
          <button depth="3" name="btnBeyondSmartPlayerLootingPush" sprite="ui_symbol_beyond_smart_loot_push" tooltip_key="btnBeyondSmartPlayerInventoryPush_ToolTip" pos="240, -22" style="icon32px, press, hover" pivot="center" sound="[paging_click]" />
        </rect>

      </append>
    </if>
  </conditional>

  <!-- Dew Collectors / Apiaries -->
  <append xpath="/windows/window[@name='windowDewCollector']/rect[@name='header']/rect">
    <rect name="beyondsmart_bp_collector" visible="true">
      <button depth="3" name="btnBeyondSmartCollectorPush" sprite="ui_symbol_beyond_smart_loot_push" tooltip_key="btnBeyondSmartCollectorPush_ToolTip" pos="280, -22" style="icon32px, press, hover" pivot="center" sound="[paging_click]" />
    </rect>
  </append>

  <!-- Loot Containers -->
  <append xpath="/windows/window[@name='windowLooting']/rect[@name='header']/rect">
    <rect name="beyondsmart_bp_loot" visible="{bs_is_any_loot_window_open}">
      <button depth="3" name="btnBeyondSmartStoragePush" visible="{!bs_is_player_storage_open}" sprite="ui_symbol_beyond_smart_loot_push" tooltip_key="btnBeyondSmartLootWindowPush_ToolTip" pos="110, -22" style="icon32px, press, hover" pivot="center" sound="[paging_click]" />
    </rect>
  </append>

  <!-- Vehicles + Drones + Dropped Loot -->
  <append xpath="/windows/window[@name='windowBagStorage']/rect[@name='header']/rect">
    <rect name="beyondsmart_bp_vehicle" visible="true" anchor_left="queue,1,-240" anchor_right="queue,1,0">
      <button depth="3" name="btnBeyondSmartDronePullLoadout" visible="{bs_is_drone_window_open}" sprite="ui_symbol_beyond_smart_loot_pull_loadout" tooltip_key="btnBeyondSmartDronePullLoadout_ToolTip" pos="0, -22" style="icon32px, press, hover" pivot="center" sound="[paging_click]" />
      <button depth="3" name="btnBeyondSmartVehiclePullLoadout" visible="{bs_is_vehicle_window_open}" sprite="ui_symbol_beyond_smart_loot_pull_loadout" tooltip_key="btnBeyondSmartVehiclePullLoadout_ToolTip" pos="0, -22" style="icon32px, press, hover" pivot="center" sound="[paging_click]" />
      <button depth="3" name="btnBeyondSmartVehiclePush" visible="{% bs_is_drone_window_open || bs_is_vehicle_window_open}" sprite="ui_symbol_beyond_smart_loot_push" tooltip_key="btnBeyondSmartVehiclePush_ToolTip" pos="40, -22" style="icon32px, press, hover" pivot="center" sound="[paging_click]" />
      <button depth="3" name="btnBeyondSmartDroppedLootPush" visible="{% !(bs_is_drone_window_open || bs_is_vehicle_window_open)}" sprite="ui_symbol_beyond_smart_loot_push" tooltip_key="btnBeyondSmartLootWindowPush_ToolTip" pos="40, -22" style="icon32px, press, hover" pivot="center" sound="[paging_click]" />
    </rect>
  </append>

  <!-- Workstation Output -->
  <append xpath="/windows/window[@name='windowOutput']/rect[@style='header.panel']/rect">
    <rect name="beyondsmart_bp_workstation_output" visible="true">
      <button depth="3" name="btnBeyondSmartWorkstationOutputPush" sprite="ui_symbol_beyond_smart_loot_push" tooltip_key="btnBeyondSmartWorkstationOutputPush_ToolTip" pos="168, -22" style="icon32px, press, hover" pivot="center" sound="[paging_click]" />
    </rect>
  </append>

  <!-- Useables window -->
  <append xpath="/windows" >

    <!-- 273 -->
    <window name="windowUseables" width="228" height="198" anchor="Top" panel="Right" cursor_area="true" 
            visible="{bs_is_player_backpack_only}" 
            controller="BeyondStorage.Harmony.Components.BeyondStorage_UseablesWindow, BeyondStorage3" >
      <rect style="header.panel">
        <headerbg />
        <sprite style="header.icon" sprite="ui_game_symbol_medical"/>
        <label style="header.name.iconright" text="BS_USEABLES" text_key="xuiBeyondUseables" />
      </rect>

      <rect name="bs_useables" pos="0,-46" height="150" disablefallthrough="true">
        <sprite depth="2" name="backgroundMain" sprite="menu_empty3px" height="150" color="[black]" type="sliced" fillcenter="false" />
        <grid depth="10" name="useables" rows="2" cols="3" pos="3,-3" cell_width="75" cell_height="75"
              controller="BeyondStorage.Harmony.Components.BeyondStorage_UseablesGrid, BeyondStorage3" repeat_content="true">
          <item_stack name="0" controller="BeyondStorage.Harmony.Components.BeyondStorage_ItemStack, BeyondStorage3"/>
        </grid>

        <!-- Hotkey number badges (1-6), bottom-left of each cell. Grid starts at pos="3,-3" with
             75x75 cells, so cell (row,col) top-left = (3 + col*75, -3 - row*75); these sit 4px in
             from the left and 59px down from the cell top, near the bottom-left corner. Label pos
             is shifted 2px further down than the background sprite so the glyph looks vertically
             centered in the badge (text otherwise renders top-aligned within its box). -->
        <sprite depth="19" pos="7,-62" height="13" width="14" color="0,0,0,250" foregroundlayer="true"/>
        <label depth="20" pos="7,-64" width="14" height="12" text="[DECEA3]1" font_size="12" color="" justify="center"/>

        <sprite depth="19" pos="82,-62" height="13" width="14" color="0,0,0,250" foregroundlayer="true"/>
        <label depth="20" pos="82,-64" width="14" height="12" text="[DECEA3]2" font_size="12" color="" justify="center"/>

        <sprite depth="19" pos="157,-62" height="13" width="14" color="0,0,0,250" foregroundlayer="true"/>
        <label depth="20" pos="157,-64" width="14" height="12" text="[DECEA3]3" font_size="12" color="" justify="center"/>

        <sprite depth="19" pos="7,-137" height="13" width="14" color="0,0,0,250" foregroundlayer="true"/>
        <label depth="20" pos="7,-139" width="14" height="12" text="[DECEA3]4" font_size="12" color="" justify="center"/>

        <sprite depth="19" pos="82,-137" height="13" width="14" color="0,0,0,250" foregroundlayer="true"/>
        <label depth="20" pos="82,-139" width="14" height="12" text="[DECEA3]5" font_size="12" color="" justify="center"/>

        <sprite depth="19" pos="157,-137" height="13" width="14" color="0,0,0,250" foregroundlayer="true"/>
        <label depth="20" pos="157,-139" width="14" height="12" text="[DECEA3]6" font_size="12" color="" justify="center"/>
      </rect>
    </window>

  </append>
  
</windows>